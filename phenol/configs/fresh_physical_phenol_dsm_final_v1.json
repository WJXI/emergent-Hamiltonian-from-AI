{
  "schema_version": 1,
  "protocol_name": "fresh-physical-phenol-unified-dsm-final-holdout-v1",
  "path_suffix": "fresh_physical_phenol_dsm_final_v1",
  "purpose": "final_holdout",
  "frozen_checkpoint_manifest": "frozen_models.json",
  "claim": "Independent same-condition molecular-dynamics holdout generated after all three networks and the sector-preserving projection were frozen; no holdout result alters training or model selection.",
  "system": {
